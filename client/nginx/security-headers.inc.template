# Rendered at container start: ${API_URL} and ${API_WS_URL} come from the environment (see docker-compose.yml).
# Google sign-in goes through Firebase (popup + iframe on *.firebaseapp.com, scripts from apis.google.com);
# avatars are served from Firebase Storage.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://storage.googleapis.com https://*.googleusercontent.com https://api.dicebear.com; font-src 'self' data:; connect-src 'self' ${API_URL} ${API_WS_URL} https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://apis.google.com; frame-src https://*.firebaseapp.com https://*.web.app https://accounts.google.com https://apis.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
