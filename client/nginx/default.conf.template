server {
    listen 80;
    # The domain is attached in Dokploy, any host name is served
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # add_header is not inherited by a location that sets its own headers, so every location includes the security headers

    # Vite fingerprints everything under /assets, so it can be cached forever
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The app shell must be revalidated so a deploy is picked up right away
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
    }

    # Client-side routing (React Router)
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri /index.html;
    }
}
