# Production variables for docker-compose.yml (paste them in Dokploy's "Environment" tab).
# For local development, use client/.env.example and server/.env.example instead.

# Public URLs, without trailing slash
CLIENT_URL=https://insighthub.teovillet.fr
API_URL=https://api.insighthub.teovillet.fr

# MongoDB container credentials — use URL-safe characters (openssl rand -hex 24)
MONGO_USER=insighthub
MONGO_PASSWORD=

# Secrets — generate each one with: openssl rand -hex 32
SECRET_ACCESS_TOKEN=
SESSION_SECRET=
# Must stay the same forever: it decrypts the stored GitHub tokens
CRYPTO_SECRET=

# Firebase Admin (avatars storage + Google sign-in verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_BUCKET_NAME=

# Firebase web config (public, baked into the client bundle at build time)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GitHub OAuth app — callback URL: ${API_URL}/api/integrations/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional, free: enables the Steam integration (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
# Optional, free: enables the Last.fm integration (https://www.last.fm/api/account/create)
LASTFM_API_KEY=
