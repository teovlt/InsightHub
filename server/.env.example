# Server Environment Variables
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Others secrets
CRYPTO_SECRET=your_crypto_secret
SECRET_ACCESS_TOKEN=secret

# MongoDB connection strings
MONG_URI=mongodb://localhost:27017/insighthub
MONG_URI_TEST=mongodb://localhost:27017/insighthub-test

# Session secret for express-session
SESSION_SECRET=your_session_secret

# Firebase configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"
FIREBASE_BUCKET_NAME=your_firebase_bucket_name

# Optional free keys: the Steam and Last.fm integrations stay disabled without them
STEAM_API_KEY=
LASTFM_API_KEY=

# Background sync of the integrations: hours between two refreshes of a connection (default 6), AUTO_SYNC=false turns it off
AUTO_SYNC_INTERVAL_HOURS=6
AUTO_SYNC=true

#Github configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth integrations: each one stays disabled until its two keys are set.
# Redirect URI to register in the service's app settings: <API URL>/api/integrations/auth/oauth/<strava|spotify>/callback
# Spotify refuses "localhost": in development, open the API as http://127.0.0.1:3000, or set the base below.
# OAUTH_CALLBACK_BASE_URL=http://127.0.0.1:3000

# Strava: https://www.strava.com/settings/api ("Authorization Callback Domain" = the API host, e.g. 127.0.0.1)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Spotify: https://developer.spotify.com/dashboard (Web API). In development mode, add each user's
# Spotify account under "User Management" or Spotify refuses their connection.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Hevy (personal API key of each user, Hevy Pro) and Letterboxd (public profile) need no server key.
